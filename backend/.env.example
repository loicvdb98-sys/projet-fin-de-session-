# SQL Server named instance installed locally as MSI\DATAVIZ.
# Replace db_password with the password configured for the sa login.
DATABASE_URL=mssql+pyodbc:///?odbc_connect=DRIVER%3DODBC%2BDriver%2B18%2Bfor%2BSQL%2BServer%3BSERVER%3DMSI%255CDATAVIZ%3BUID%3Dsa%3BPWD%3Ddb_password%3BDATABASE%3DGestionSeancesSport%3BTrustServerCertificate%3Dyes
# Clé de signature des JWT : au moins 32 caractères (l'API refuse de démarrer sinon).
# Générez-en une avec : py -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Optionnel : tester depuis un téléphone du même Wi-Fi (voir README, « Tester sur un téléphone »).
# ALLOWED_ORIGIN_REGEX=http://192\.168\.\d{1,3}\.\d{1,3}:4200
# Documentation interactive /docs : à mettre à false en production.
EXPOSE_API_DOCS=true
# Fuseau des heures écrites dans les notifications (les dates sont stockées en UTC).
APP_TIMEZONE=Europe/Paris
